# Required: set a unique username and password of at least 16 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional editor account; configure both values or leave both unset.
EDITOR_USERNAME=
EDITOR_PASSWORD=
# Comma-separated list of trusted browser origins.
FRONTEND_ORIGIN=http://localhost:5173
# Set only when deployed behind exactly one trusted reverse proxy.
TRUST_PROXY=false
# Set to the canonical HTTPS origin for production SEO assets and canonical URLs.
VITE_SITE_URL=
